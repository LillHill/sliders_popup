{
  "width": 400,
  "anchor": "top right",
  "margin": { "top": 10, "right": 10 },
  "layer": "overlay",
  "close_on_focus_loss": true,
  "css": "themes/catppuccin.css",
  "orientation": "vertical",
  "sliders": [
    {
      "name": "gap_outer",
      "label": "Outer Gaps",
      "cmd": "hyprctl keyword general:gaps_out ${VAL}",
      "min": 0,
      "max": 50,
      "step": 1,
      "value": 5
    },
    {
      "name": "gap_inner",
      "label": "Inner Gaps",
      "cmd": "hyprctl keyword general:gaps_in ${VAL}",
      "min": 0,
      "max": 30,
      "step": 1,
      "value": 5
    },
    {
      "name": "border_size",
      "label": "Border Size",
      "cmd": "hyprctl keyword general:border_size ${VAL}",
      "min": 0,
      "max": 10,
      "step": 1,
      "value": 2
    },
    {
      "name": "rounding",
      "label": "Corner Rounding",
      "cmd": "hyprctl keyword decoration:rounding ${VAL}",
      "min": 0,
      "max": 20,
      "step": 1,
      "value": 10
    },
    {
      "name": "opacity",
      "label": "Active Opacity",
      "cmd": "hyprctl keyword decoration:active_opacity ${VAL}",
      "min": 0.1,
      "max": 1.0,
      "step": 0.05,
      "value": 1.0,
      "digits": 2
    }
  ]
}
