{
  "width": 300,
  "anchor": "top right",
  "margin": { "top": 10, "right": 10 },
  "layer": "overlay",
  "close_on_focus_loss": true,
  "css": "themes/gruvbox.css",
  "orientation": "vertical",
  "spacing": 6,
  "children": [
    {
      "type": "switch",
      "name": "wifi",
      "label": "Wi-Fi",
      "cmd_on": "nmcli radio wifi on",
      "cmd_off": "nmcli radio wifi off",
      "read_cmd": "nmcli radio wifi | grep -q enabled && echo 1 || echo 0"
    },
    {
      "type": "switch",
      "name": "bluetooth",
      "label": "Bluetooth",
      "cmd_on": "bluetoothctl power on",
      "cmd_off": "bluetoothctl power off",
      "read_cmd": "bluetoothctl show | grep -q 'Powered: yes' && echo 1 || echo 0"
    },
    {
      "type": "switch",
      "name": "dnd",
      "label": "Do Not Disturb",
      "cmd_on": "makoctl mode -a dnd",
      "cmd_off": "makoctl mode -r dnd"
    },
    {
      "type": "switch",
      "name": "idle",
      "label": "Screen Lock",
      "cmd_on": "pidof swayidle || swayidle &",
      "cmd_off": "pkill swayidle",
      "read_cmd": "pidof swayidle > /dev/null && echo 1 || echo 0"
    },
    {
      "type": "button",
      "name": "lock",
      "label": "Lock Now",
      "cmd": "swaylock"
    },
    {
      "type": "button",
      "name": "power_menu",
      "label": "Power Menu",
      "cmd": "wlogout"
    }
  ]
}
