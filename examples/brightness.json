{
  "width": 300,
  "anchor": "top right",
  "margin": { "top": 10, "right": 10 },
  "layer": "overlay",
  "close_on_focus_loss": true,
  "css": "style.css",
  "orientation": "vertical",
  "sliders": [
    {
      "name": "brightness",
      "label": "Display",
      "cmd": "brightnessctl set ${VAL}%",
      "min": 1,
      "max": 100,
      "step": 1,
      "value": 75
    },
    {
      "name": "kbd_backlight",
      "label": "Keyboard",
      "cmd": "brightnessctl -d '*::kbd_backlight' set ${VAL}%",
      "min": 0,
      "max": 100,
      "step": 5,
      "value": 50
    }
  ]
}
