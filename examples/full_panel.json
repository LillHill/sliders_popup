{
  "width": 380,
  "anchor": "top right",
  "margin": { "top": 10, "right": 10 },
  "layer": "overlay",
  "close_on_focus_loss": true,
  "css": "themes/transparent.css",
  "orientation": "vertical",
  "spacing": 6,
  "children": [
    {
      "type": "slider",
      "name": "volume",
      "label": "Volume",
      "cmd": "wpctl set-volume @DEFAULT_AUDIO_SINK@ ${VAL}%",
      "read_cmd": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%.0f\", $2 * 100}'",
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "type": "slider",
      "name": "brightness",
      "label": "Brightness",
      "cmd": "brightnessctl set ${VAL}%",
      "read_cmd": "brightnessctl -m | awk -F, '{print int($4)}'",
      "min": 1,
      "max": 100,
      "step": 1
    },
    {
      "type": "box",
      "orientation": "horizontal",
      "spacing": 12,
      "children": [
        {
          "type": "switch",
          "name": "mute",
          "label": "Mute",
          "cmd": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "read_cmd": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo 0 || echo 1"
        },
        {
          "type": "switch",
          "name": "wifi",
          "label": "Wi-Fi",
          "cmd": "sh -c 'if [ \"$VAL\" = 1 ]; then nmcli radio wifi on; else nmcli radio wifi off; fi'",
          "read_cmd": "nmcli radio wifi | grep -q enabled && echo 1 || echo 0"
        }
      ]
    },
    {
      "type": "box",
      "orientation": "horizontal",
      "spacing": 8,
      "children": [
        { "type": "button", "name": "lock", "label": "Lock", "cmd": "swaylock" },
        { "type": "button", "name": "dpms", "label": "Screen Off", "cmd": "sleep 0.5 && hyprctl dispatch dpms off" },
        { "type": "button", "name": "power", "label": "Power", "cmd": "wlogout" }
      ]
    }
  ]
}
