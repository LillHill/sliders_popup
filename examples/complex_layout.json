{
  "width": 450,
  "height": 400,
  "anchor": "center",
  "layer": "overlay",
  "close_on_focus_loss": true,
  "css": "themes/catppuccin.css",
  "orientation": "horizontal",
  "spacing": 12,
  "children": [
    {
      "type": "box",
      "orientation": "vertical",
      "spacing": 8,
      "name": "left_panel",
      "children": [
        {
          "type": "box",
          "orientation": "horizontal",
          "spacing": 8,
          "homogeneous": true,
          "children": [
            {
              "type": "slider",
              "name": "vol",
              "label": "Vol",
              "orientation": "vertical",
              "length": 200,
              "cmd": "wpctl set-volume @DEFAULT_AUDIO_SINK@ ${VAL}%",
              "read_cmd": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%.0f\", $2 * 100}'",
              "min": 0,
              "max": 100,
              "step": 1,
              "value_pos": "bottom"
            },
            {
              "type": "slider",
              "name": "mic",
              "label": "Mic",
              "orientation": "vertical",
              "length": 200,
              "cmd": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ ${VAL}%",
              "read_cmd": "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{printf \"%.0f\", $2 * 100}'",
              "min": 0,
              "max": 100,
              "step": 1,
              "value_pos": "bottom"
            }
          ]
        },
        {
          "type": "box",
          "orientation": "horizontal",
          "spacing": 6,
          "children": [
            { "type": "button", "name": "mute", "label": "Mute", "cmd": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" },
            { "type": "button", "name": "mute_mic", "label": "Mute Mic", "cmd": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle" }
          ]
        }
      ]
    },
    {
      "type": "box",
      "orientation": "vertical",
      "spacing": 8,
      "name": "right_panel",
      "children": [
        {
          "type": "slider",
          "name": "brightness",
          "label": "Brightness",
          "cmd": "brightnessctl set ${VAL}%",
          "read_cmd": "brightnessctl -m | awk -F, '{print int($4)}'",
          "min": 1,
          "max": 100,
          "step": 1
        },
        {
          "type": "slider",
          "name": "kbd_bl",
          "label": "Kbd Backlight",
          "cmd": "brightnessctl -d '*::kbd_backlight' set ${VAL}%",
          "min": 0,
          "max": 100,
          "step": 10,
          "value": 50
        },
        {
          "type": "switch",
          "name": "wifi",
          "label": "Wi-Fi",
          "cmd": "sh -c 'if [ \"$VAL\" = 1 ]; then nmcli radio wifi on; else nmcli radio wifi off; fi'",
          "read_cmd": "nmcli radio wifi | grep -q enabled && echo 1 || echo 0"
        },
        {
          "type": "switch",
          "name": "bt",
          "label": "Bluetooth",
          "cmd": "sh -c 'if [ \"$VAL\" = 1 ]; then bluetoothctl power on; else bluetoothctl power off; fi'",
          "read_cmd": "bluetoothctl show | grep -q 'Powered: yes' && echo 1 || echo 0"
        },
        {
          "type": "button",
          "name": "lock",
          "label": "Lock Screen",
          "cmd": "swaylock"
        }
      ]
    }
  ]
}
